.page {
  padding: 24rpx 24rpx 40rpx;
}

/* 顶部统计 */
.hero {
  background: linear-gradient(135deg, #4A7CF9 0%, #3D6EF7 55%, #5B54E8 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 30rpx;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(61, 110, 247, 0.35);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-total, .stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.8;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.hero-bar {
  margin-top: 28rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.hero-bar-inner {
  height: 100%;
  border-radius: 6rpx;
  background: #fff;
  transition: width 0.4s ease;
}

/* 模式入口 */
.modes {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.mode-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 60, 110, 0.06);
  display: flex;
  flex-direction: column;
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.mode-icon-blue {
  background: #EAF0FE;
}

.mode-icon-red {
  background: #FDEBEA;
}

.mode-name {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.mode-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A91A3;
}

/* 章节 */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 36rpx 8rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-action {
  font-size: 24rpx;
  color: #8A91A3;
  padding: 8rpx 16rpx;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chapter {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.chapter:active {
  background: #F7F9FF;
}

.chapter-main {
  flex: 1;
  min-width: 0;
}

.chapter-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.chapter-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A91A3;
}

.chapter-dot {
  margin: 0 8rpx;
}

.meta-green {
  color: #22B573;
}

.meta-orange {
  color: #F59A23;
}

.chapter-right {
  width: 150rpx;
  margin-left: 20rpx;
  text-align: right;
}

.chapter-percent {
  font-size: 26rpx;
  font-weight: 700;
  color: #3D6EF7;
}

.chapter-bar {
  margin-top: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #EDF0F7;
  overflow: hidden;
}

.chapter-bar-inner {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #6E96FA, #3D6EF7);
}

.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #B6BCCB;
}
